RewriteEngine On

# If the request is for a real directory or file, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Map /product-slug/category-slug to dynamic-product.php?slug=$1&category=$2
RewriteRule ^([^/.]+)/([^/.]+)/?$ dynamic-product.php?slug=$1&category=$2 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Map /product-slug to dynamic-product.php?slug=$1
RewriteRule ^([^/.]+)/?$ dynamic-product.php?slug=$1 [L,QSA]
